# 复制为 .env 后填写。不要把真实的 .env 提交到仓库或打进镜像。

# ---- M-Team ----
# 馒头控制台 → 实验室 → 存取令牌；也可以登录后在设置页填写
MT_API_KEY=
MT_API_BASE=https://api.m-team.cc/api
MT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
# 搜索最小间隔（秒）；0 表示不限速。也可在设置页运行时覆盖。
MT_SEARCH_MIN_INTERVAL_SEC=0
# 24h 搜索预算；设置页的“24h 搜索预算”保存后覆盖此项并立即生效
MT_SEARCH_DAILY_BUDGET=400
MT_DOWNLOAD_DAILY_BUDGET=60
# 账号资料刷新（分享率护栏）的 24h 预算
MT_PROFILE_DAILY_BUDGET=200
MT_TIMEOUT_SEC=30

# ---- 豆瓣榜单 ----
# 读取公开榜单，不需要豆瓣账号或 Cookie
DOUBAN_TIMEOUT_SEC=15
DOUBAN_CACHE_SEC=600

# ---- qBittorrent ----
# 不要写容器内的 127.0.0.1；填极空间局域网 IP + qB 映射端口
QB_URL=http://192.168.1.10:8080
QB_USERNAME=admin
QB_PASSWORD=
QB_SAVE_PATH=/downloads
QB_CATEGORY=mtbox
QB_TAGS=mtbox
QB_TIMEOUT_SEC=15

# ---- 路径（容器内，不要改）----
DOWNLOAD_DIR=/downloads
LIBRARY_DIR=/media
DATA_DIR=/config
# qB 报告的路径前缀 → 本容器路径前缀
PATH_MAP_JSON=[["/downloads","/downloads"]]

# ---- 管理端 ----
ADMIN_USERNAME=admin
# 管理端密码；若包含 $，用单引号包住
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- 行为 ----
# 是否读取系统/环境代理；NAS 直连 MT/豆瓣时保持 false
TRUST_ENV_PROXY=false
DRY_RUN=true
SCHEDULER_ENABLED=true
ORGANIZE_DELAY_SEC=15
MIN_VIDEO_SIZE_MB=50
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---- 端口（docker compose 变量）----
# 容器内监听端口，默认 8080
PORT=8080
# 宿主机映射端口，避免与 qBittorrent 的 8080 冲突
MTBOX_PORT=18080

# ---- 极空间宿主机路径（docker compose 变量）----
# 按极空间实际目录修改
MTBOX_CONFIG_PATH=/vol1/mtbox/config
MTBOX_DOWNLOADS_PATH=/vol1/downloads
MTBOX_LIBRARY_PATH=/vol1/media
