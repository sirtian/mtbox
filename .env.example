# ---- M-Team ----
# 控制台 → 实验室 → 存取令牌
# 也可登录后在 /settings 更新；设置页保存的值优先于这里
MT_API_KEY=
MT_API_BASE=https://api.m-team.cc/api
# 浏览器 UA，降低 Cloudflare 1010 概率
MT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
MT_SEARCH_MIN_INTERVAL_SEC=20
# 24h 搜索预算；设置页的“24h 搜索预算”保存后覆盖此项并立即生效
MT_SEARCH_DAILY_BUDGET=400
MT_DOWNLOAD_DAILY_BUDGET=60
# 账号资料刷新（分享率护栏）的 24h 预算
MT_PROFILE_DAILY_BUDGET=200
MT_TIMEOUT_SEC=30

# ---- 豆瓣榜单 ----
# 只读取公开榜单，不需要账号或 Cookie
DOUBAN_TIMEOUT_SEC=15
DOUBAN_CACHE_SEC=600

# ---- qBittorrent ----
QB_URL=http://127.0.0.1:8080
QB_USERNAME=admin
# 也可登录后在 /settings 更新；设置页保存的值优先于这里
QB_PASSWORD=
# qB 容器内看到的保存路径
QB_SAVE_PATH=/downloads
QB_CATEGORY=mtbox
QB_TAGS=mtbox
QB_TIMEOUT_SEC=15

# ---- 路径（本容器内）----
DOWNLOAD_DIR=/downloads
LIBRARY_DIR=/media
DATA_DIR=/config
# qB 前缀 → 本地前缀（JSON，最长前缀优先）
PATH_MAP_JSON=[["/downloads","/downloads"]]

# ---- 管理端 ----
ADMIN_USERNAME=admin
# 管理端密码；若包含 $，在 Compose 的 .env 中用单引号包住
ADMIN_PASSWORD=
# 不填则自动生成并保存到 DATA_DIR/secret.key
SESSION_SECRET=

# ---- Web ----
# 监听端口；也可用 `mtbox serve --port` 或 uvicorn --port 覆盖
PORT=8080

# ---- 行为 ----
# 是否读取系统/环境代理（HTTP_PROXY、Windows 系统代理）
# 目标 NAS 直连 MT/豆瓣，保持 false；仅在确实需要代理时改为 true
TRUST_ENV_PROXY=false
DRY_RUN=true
SCHEDULER_ENABLED=true
ORGANIZE_DELAY_SEC=15
MIN_VIDEO_SIZE_MB=50
LOG_LEVEL=INFO
TZ=Asia/Shanghai
